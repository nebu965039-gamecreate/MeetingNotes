# リリース署名(Play App Signing のアップロード鍵)設定。
# このファイルを keystore.properties にコピーして値を埋める(keystore.properties はgitignore対象)。
#
# アップロード鍵の生成コマンド(プロジェクトルートで実行):
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile はプロジェクトルートからの相対パス。
storeFile=upload-keystore.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
