sdk.dir=C\:\\Users\\zhong\\AppData\\Local\\Android\\Sdk
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AdMob の広告ユニット。既定(未設定/false)は Google 公式テスト広告。
# クローズドテストもローカル開発もテスト広告のままでよい。
# 本番/オープンテスト用の AAB をビルドするときだけ true にする。
ADMOB_USE_PRODUCTION_ADS=false
# 本番広告に切り替えたあと、実機テスターにテスト広告を出す端末ID(カンマ区切り、任意)。
# アプリ起動時の logcat の "setTestDeviceIds(Arrays.asList("XXXX"))" の XXXX を追記する。
# テスト広告のうち・エミュレータは設定不要。
ADMOB_TEST_DEVICE_IDS=
