<?xml version="1.0" encoding="utf-8"?>
<!--
  「今日の予定」+「今日までのToDo」ウィジェット。
  RemoteViews は限られたビュー(LinearLayout/TextView等)しか使えないため、
  予定・ToDoとも最大4行ぶんのTextViewを固定で用意し、件数に応じて表示/非表示("+N件"含む)を
  切り替える方式(スクロール可能なリスト表示はRemoteViewsServiceが必要になり複雑なため、
  シンプルな固定行数のV1として実装)。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_on_background"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="9月20日(日)" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="本日の予定"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_schedule_1"
        style="@style/WidgetItemText" />

    <TextView
        android:id="@+id/widget_schedule_2"
        style="@style/WidgetItemText" />

    <TextView
        android:id="@+id/widget_schedule_3"
        style="@style/WidgetItemText" />

    <TextView
        android:id="@+id/widget_schedule_more"
        style="@style/WidgetItemTextDim" />

    <TextView
        android:id="@+id/widget_schedule_empty"
        style="@style/WidgetItemTextDim"
        android:text="本日の予定はありません" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="今日までのToDo"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_todo_1"
        style="@style/WidgetItemText" />

    <TextView
        android:id="@+id/widget_todo_2"
        style="@style/WidgetItemText" />

    <TextView
        android:id="@+id/widget_todo_3"
        style="@style/WidgetItemText" />

    <TextView
        android:id="@+id/widget_todo_more"
        style="@style/WidgetItemTextDim" />

    <TextView
        android:id="@+id/widget_todo_empty"
        style="@style/WidgetItemTextDim"
        android:text="ToDoはありません" />

</LinearLayout>
